# Docker Compose: дані, з якими буде створено контейнер PostgreSQL.
# Ці самі значення ви введете в інсталяторі на кроці «База даних».
POSTGRES_DB=yework
POSTGRES_USER=yework
POSTGRES_PASSWORD=змініть-цей-пароль
# Домен сайту (для HTTPS через Caddy). Для локальної перевірки: localhost
SITE_DOMAIN=localhost
