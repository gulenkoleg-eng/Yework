# YEWORK: маршрутизація та захист службових папок (Apache / LiteSpeed).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Службові папки недоступні з браузера.
  RewriteRule ^(app|config|storage|database|docs)(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(sql|md|lock|log|json|txt|sh)$ - [F,L,NC]

  # Справжні файли (css, js, зображення) віддаються напряму.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^assets/ - [L]

  # Усе інше — на index.php.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>
